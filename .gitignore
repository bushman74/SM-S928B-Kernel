# --- Our build outputs and fetched toolchains (never committed) ---
/out/
/toolchain/
/scratch/
/build.log

# Prebuilts fetched by scripts/setup-toolchain.sh (clang, kernel-build-tools, jdk,
# ndk, ...) from the android14-6.1 kernel manifest. Multi-GB, reproducible, and each
# is its own git checkout — never commit them.
/kernel_platform/prebuilts/

# Samsung's OSRC drop ships a ~131 MB host GCC prebuilt and build-machine bazel
# symlinks; neither belongs in git (CLAUDE.md: never commit toolchains). The GKI
# build fetches clang via scripts/setup-toolchain.sh.
/kernel_platform/gcc/
/kernel_platform/bazel-bin
/kernel_platform/bazel-out
/kernel_platform/bazel-testlogs
/kernel_platform/bazel-kernel_platform

# Binary/firmware artifacts that must never be committed (CLAUDE.md).
# These extensions do NOT occur in the Samsung source tree, so the vanilla
# import stays faithful. (The tree's *.tar/*.zip/*.gz are bazel rules_pkg test
# fixtures and are deliberately kept — hence no blanket patterns for those.)
*.ko
*.img
*.img.lz4
*.tar.md5
*.tgz
*.zst

# Python bytecode from the in-tree tools we invoke (e.g. tools/mkbootimg/mkbootimg.py,
# run by scripts/package.sh). These caches are generated, never part of a Samsung source
# drop, so ignoring them keeps the vanilla import faithful and the tree clean after a
# local package run.
__pycache__/
*.pyc

# Editor / OS cruft
*.swp
*~
.DS_Store
